# Server Configuration
# Port for the application to run on (default: 5000)
PORT=5000

# Node environment (development, production, or test)
NODE_ENV=development

# Database Configuration
# PostgreSQL connection string (if using database features in the future)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=

# Session Configuration
# Secret key for session encryption (generate a random string)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-session-key-here

# Google Sheets API (Required for product data)
# Your Google Sheets Web App deployment URL
# Example: https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GOOGLE_SHEET_URL=

# Optional: API Keys for External Services
# Add any additional API keys or configuration as needed
